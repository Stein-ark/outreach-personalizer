# Copy to extension/.env.production for `npm run build` / `npm run zip`. These values are public (they ship in
# the extension), never put secrets here. The build fails if a secret pattern is found in the output.
WXT_API_BASE_URL=https://api.your-domain.example
# Public key from `node scripts/gen-key.mjs`, gives the extension a stable id for the server CORS allowlist.
WXT_EXTENSION_KEY=
