{
  "name": "outreach-personalizer",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "server",
    "extension"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:extension": "npm run dev -w extension",
    "build": "npm run build -w packages/shared && npm run build -w server && npm run build -w extension",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "zip": "npm run zip -w extension"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true,
    "mongodb-memory-server@11.3.0": true
  }
}
