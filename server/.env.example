# Copy to server/.env and fill in. Never commit .env.
NODE_ENV=development
PORT=8787
LOG_LEVEL=info
# Set to the number of reverse proxies in front of the server in production (for example 1 behind a TLS load balancer).
TRUST_PROXY_HOPS=0

# MongoDB Atlas connection string (Database > Connect > Drivers).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/outreach?retryWrites=true&w=majority

# The extension origin. Get the id from extension/scripts/gen-key.mjs output or chrome://extensions.
CORS_ORIGINS=chrome-extension://REPLACE_WITH_32_CHAR_EXTENSION_ID

# At least 32 random characters, for example: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Leave unset: signup is open only until the first account exists. "true" or "false" forces it.
# ALLOW_SIGNUP=

# AI provider (any OpenAI compatible endpoint). Defaults target Groq.
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
# Verified production model on 2026-10-25. Check https://console.groq.com/docs/deprecations before changing.
AI_MODEL=openai/gpt-oss-120b
AI_REASONING_EFFORT=low
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS_DRAFT=1200
AI_MAX_OUTPUT_TOKENS_EXTRACT=800

# Shared limiter, kept below the Groq free tier limits for gpt-oss-120b (30 RPM, 1K RPD, 8K TPM, 200K TPD).
AI_LIMIT_RPM=25
AI_LIMIT_TPM=7000
AI_LIMIT_RPD=950
AI_LIMIT_TPD=190000
AI_LIMIT_MAX_WAIT_MS=15000

DAILY_DRAFT_CAP=100
DAILY_EXTRACT_CAP=200
